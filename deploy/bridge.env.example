# Administrator-owned: /etc/ibkr-bridge/bridge.env, mode 0640 root:ibkr-exec
IBKR_MODE=paper
IBKR_ACCOUNT=REPLACE_WITH_EXPLICIT_PAPER_ACCOUNT
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=777
IBKR_BASE_CURRENCY=EUR
IBKR_ALLOW_ORDERS=false
IBKR_STATE_DIR=/var/lib/ibkr-bridge
IBKR_RULES_PATH=/etc/ibkr-bridge/paper-trading-rules.yaml
IBKR_PROPOSAL_DIR=/var/lib/ibkr-proposals
H1_APPROVAL_TOKEN_HASH=
IBKR_RELEASE=unverified
