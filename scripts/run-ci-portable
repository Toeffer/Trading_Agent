#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

PYTHON="python3"
[ -x ".venv/bin/python" ] && PYTHON=".venv/bin/python"

TESTS=(
  tests/test_ci_collection_safety.py
  tests/test_ci_invariant_assertions.py
  tests/test_strategy_autonomy_docs.py
  tests/test_kpi_dashboard.py
  tests/test_phase17c_level1_strategy_v1_dry_run_proposal_generation_checkpoint.py
  tests/test_phase17d_level1_proposal_review_rejection_dossier_checkpoint.py
  tests/test_phase17e_level1_human_review_decision_record_checkpoint.py
  tests/test_phase17f_level1_planning_only_order_plan_draft_checkpoint.py
)

echo "==> Portable CI"
echo "==> Python: $($PYTHON --version)"

$PYTHON -m py_compile bridge.py guard.py ibkr_operator.py

$PYTHON -m pytest --collect-only -q "${TESTS[@]}" \
  -m "not integration and not live and not acceptance"

$PYTHON -m pytest -q "${TESTS[@]}" \
  -m "not integration and not live and not acceptance"
